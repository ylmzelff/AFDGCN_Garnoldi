// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PhasePrediction {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now()) @map("created_at")
  region           String   @db.VarChar(50)
  city             String   @default("kayseri") @db.VarChar(50)
  timeLabel        String   @map("time_label") @db.VarChar(10)
  minuteIndex      Int      @map("minute_index")
  predictionSource String   @map("prediction_source") @db.VarChar(30)
  kayseriApiStatus String   @map("kayseri_api_status") @db.VarChar(20)
  junctionCount    Int      @map("junction_count")
  totalVehicles    Int      @default(0) @map("total_vehicles")
  payload          Json?

  @@index([createdAt])
  @@index([region])
  @@map("phase_predictions")
}

model ModelEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  eventType String   @map("event_type") @db.VarChar(30)
  modelPath String   @default("") @map("model_path") @db.VarChar(255)
  numNodes  Int?     @map("num_nodes")
  lag       Int?
  details   String   @default("") @db.VarChar(500)

  @@index([createdAt])
  @@index([eventType])
  @@map("model_events")
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique @db.VarChar(64)
  hashedPassword String   @map("hashed_password")
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("users")
}
