# Uygulama
PORT=9001
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=1.0.0

# JWT
JWT_SECRET=kayseri-traffic-api-secret-key-2026-change-in-production
JWT_EXPIRES_IN_SECONDS=86400

# Veritabanı
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/afdgcn"

# Kayseri Belediye API (port 9000)
KAYSERI_API_URL=http://localhost:9000
KAYSERI_USERNAME=demo
KAYSERI_PASSWORD=demo123

# Python AFDGCN Model Sunucusu (port 9002)
PYTHON_MODEL_URL=http://localhost:9002

# WebSocket yayın aralığı (ms)
WS_BROADCAST_INTERVAL_MS=600000

# Arka plan çekme aralığı (ms)
BG_FETCH_INTERVAL_MS=60000
